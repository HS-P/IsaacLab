+        def process(self, observation_dict):
+            # observation_dict에서 extrinsics_obs를 가져옵니다.
+            obs = observation_dict["extrinsics_obs"]   # shape: (B, obs_dim)
+            # extrinsics_obs 외 추가 환경 정보가 있다면 가져오고, 없으면 0으로 채웁니다.
+            env_input = observation_dict.get("env_info", torch.zeros_like(obs))
+            # 두 정보를 concatenate합니다.
